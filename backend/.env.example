# Copy this file to .env and fill it in. Never share the real .env or put it in a public place.
# (Keep comments on their own lines, like these: some Docker versions do not accept a comment after a value.)

# ---- required ----
# A long random string. Make one with:  python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.scrappy.example.com
# The address people reach this server at (used in the customer's bill link)
PUBLIC_BASE_URL=https://api.scrappy.example.com
DATABASE_URL=postgresql://scrappy:CHANGE_ME@db:5432/scrappy
# Used by docker-compose for the database container. Use the same password in DATABASE_URL above.
POSTGRES_PASSWORD=CHANGE_ME
# The domain the HTTPS proxy answers for (same as the host above)
SITE_ADDRESS=api.scrappy.example.com

# ---- the website ----
# If this server also serves the website files, point to the folder made by tools/point_frontend.py:
FRONTEND_DIR=/srv/site
# If the website stays on another address (for example Cloudflare), list its address here instead:
# CORS_ALLOWED_ORIGINS=https://scrappy-manager.example.workers.dev

# ---- storage ----
# Where PDF bills are kept. Back this folder up together with the database.
MEDIA_ROOT=/data/media

# ---- optional ----
# 1 = a new login signs the person out on their other phone (the original rule)
# SINGLE_SESSION=1
# Warehouse weighing tolerance, in percent
# WEIGHING_TOLERANCE_PCT=2
# Wrong passwords allowed per email and address before a 15 minute pause
# LOGIN_MAX_FAILURES=10
# Needed only if you run more than one server machine (shares the login lock counters)
# REDIS_URL=redis://redis:6379/0
# Keep on for a live site (set 0 only for a quick test over plain http)
# SECURE_SSL_REDIRECT=1
# LOG_LEVEL=INFO
